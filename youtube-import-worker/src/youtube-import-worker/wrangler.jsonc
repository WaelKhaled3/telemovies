{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "telemovies-youtube-import",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "vars": {
    "ALLOWED_ORIGIN": "https://telemovies.wk7.workers.dev"
  },
  "ratelimits": [
    {
      "name": "YOUTUBE_IMPORT_LIMITER",
      "namespace_id": "87132013",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
